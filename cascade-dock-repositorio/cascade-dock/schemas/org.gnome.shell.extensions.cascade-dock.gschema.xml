<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.cascade-dock" path="/org.gnome.shell.extensions.cascade-dock/">

    <!-- Posição -->
    <key name="position" type="s">
      <default>'top'</default>
      <summary>Posição do dock (top ou bottom)</summary>
    </key>
    <key name="margin" type="i">
      <default>6</default>
      <range min="0" max="100"/>
      <summary>Distância da borda da tela (px)</summary>
    </key>

    <!-- Zoom -->
    <key name="zoom-factor" type="d">
      <default>1.8</default>
      <range min="1.0" max="3.0"/>
      <summary>Fator de zoom (1.0 = sem zoom)</summary>
    </key>
    <key name="zoom-radius" type="d">
      <default>1.3</default>
      <range min="0.5" max="3.0"/>
      <summary>Alcance do zoom, em ícones vizinhos</summary>
    </key>
    <key name="follow-speed" type="i">
      <default>30</default>
      <range min="0" max="300"/>
      <summary>Suavidade ao seguir o mouse (ms)</summary>
    </key>
    <key name="anim-speed" type="i">
      <default>150</default>
      <range min="0" max="1000"/>
      <summary>Duração da animação de retorno (ms)</summary>
    </key>

    <!-- Aparência -->
    <key name="icon-size" type="i">
      <default>48</default>
      <range min="24" max="128"/>
      <summary>Tamanho base dos ícones (px)</summary>
    </key>
    <key name="spacing" type="i">
      <default>8</default>
      <range min="0" max="40"/>
      <summary>Espaço entre ícones (px)</summary>
    </key>
    <key name="bg-color" type="s">
      <default>'rgb(24,24,28)'</default>
      <summary>Cor do fundo</summary>
    </key>
    <key name="bg-opacity" type="d">
      <default>0.55</default>
      <range min="0.0" max="1.0"/>
      <summary>Opacidade do fundo</summary>
    </key>
    <key name="corner-radius" type="i">
      <default>22</default>
      <range min="0" max="60"/>
      <summary>Arredondamento (px)</summary>
    </key>
    <key name="show-border" type="b">
      <default>true</default>
      <summary>Borda sutil ao redor do dock</summary>
    </key>

    <!-- Indicadores e extras -->
    <key name="show-indicators" type="b">
      <default>true</default>
      <summary>Bolinha sob apps abertos</summary>
    </key>
    <key name="indicator-size" type="i">
      <default>4</default>
      <range min="2" max="10"/>
      <summary>Tamanho da bolinha (px)</summary>
    </key>
    <key name="show-running" type="b">
      <default>true</default>
      <summary>Mostrar apps abertos que não estão fixados</summary>
    </key>
    <key name="show-labels" type="b">
      <default>true</default>
      <summary>Mostrar o nome do app ao passar o mouse</summary>
    </key>
    <key name="bounce" type="b">
      <default>true</default>
      <summary>Quicar o ícone ao abrir um app</summary>
    </key>

    <!-- Prévia de janelas -->
    <key name="show-previews" type="b">
      <default>true</default>
      <summary>Mostrar miniaturas das janelas ao passar o mouse</summary>
    </key>
    <key name="preview-delay" type="i">
      <default>0</default>
      <range min="0" max="2000"/>
      <summary>Atraso para mostrar as miniaturas (ms)</summary>
    </key>
    <key name="preview-size" type="i">
      <default>220</default>
      <range min="120" max="400"/>
      <summary>Largura máxima de cada miniatura (px)</summary>
    </key>

    <!-- Autohide -->
    <key name="autohide" type="b">
      <default>false</default>
      <summary>Esconder o dock automaticamente</summary>
    </key>
    <key name="hide-delay" type="i">
      <default>400</default>
      <range min="0" max="3000"/>
      <summary>Atraso para esconder (ms)</summary>
    </key>
    <key name="show-delay" type="i">
      <default>150</default>
      <range min="0" max="2000"/>
      <summary>Atraso para mostrar (ms)</summary>
    </key>
    <key name="autohide-speed" type="i">
      <default>250</default>
      <range min="0" max="1000"/>
      <summary>Duração da animação de esconder/mostrar (ms)</summary>
    </key>
    <key name="edge-size" type="i">
      <default>2</default>
      <range min="1" max="20"/>
      <summary>Faixa da borda que revela o dock (px)</summary>
    </key>
    <key name="hide-in-overview" type="b">
      <default>true</default>
      <summary>Esconder o dock na visão geral de atividades</summary>
    </key>
  </schema>
</schemalist>
